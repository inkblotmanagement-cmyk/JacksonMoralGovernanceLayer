# JMGL API configuration (12-factor: every value can also be set as a real environment variable).
# Copy to .env for local use. NEVER commit a real .env.

# --- general -----------------------------------------------------------------------------
JMGL_ENVIRONMENT=development          # development | test | production (production enforces safe settings)
JMGL_REGION=local                     # label stored on every audit record (e.g. us-east1, europe-west1)
JMGL_LOG_LEVEL=INFO
JMGL_LOG_JSON=true

# --- engine ------------------------------------------------------------------------------
JMGL_MODE=ensemble                    # ensemble (rules + learned classifier) | rules
JMGL_ALLOW_MODE_OVERRIDE=true         # let callers send "mode" per request
JMGL_REQUIRE_MODEL=false              # true: /readyz returns 503 while the classifier is not loaded
JMGL_WARMUP_MODEL=true
# JMGL_LAWS_PATH=/config/laws.json    # custom wording/default decisions (law ids must stay JL-00..JL-10)
# JMGL_MODEL_DIR=/models/jmgl         # alternative classifier weights (clf.npz + clf_meta.json)

# --- auth: SHA-256 hashes of API keys, comma-separated. Generate: `jmgl-server gen-key` ------
# The two hashes below belong to SAMPLE keys for local testing only:
#   client key: jmgl_dev_client_DO_NOT_USE_IN_PRODUCTION
#   admin key:  jmgl_dev_admin_DO_NOT_USE_IN_PRODUCTION
# The server refuses to start with these when JMGL_ENVIRONMENT=production.
JMGL_AUTH_ENABLED=true
JMGL_CLIENT_KEY_HASHES=fe1a7a99bab63d96dd8b1a94ff45d08204be10f5041d85fa033513b7e9ab0d32
JMGL_ADMIN_KEY_HASHES=d3ac77c764adb3d99cd20fec6a77004957aabea0767ea4e206463e32cc006e63
JMGL_LAWS_PUBLIC=true
JMGL_METRICS_PUBLIC=true              # keep /metrics off the public ingress, or set false (admin key needed)

# --- rate limiting -----------------------------------------------------------------------
JMGL_RATE_LIMIT_ENABLED=true
JMGL_RATE_LIMIT_PER_MINUTE=120        # per API key
JMGL_RATE_LIMIT_PUBLIC_PER_MINUTE=60  # per client IP on public endpoints
# JMGL_RATE_LIMIT_REDIS_URL=redis://redis:6379/0   # share limits across replicas
JMGL_TRUST_PROXY_HEADERS=false        # true only behind a trusted proxy/load balancer

# --- request limits ----------------------------------------------------------------------
JMGL_MAX_BODY_BYTES=262144
JMGL_MAX_ACTION_CHARS=8000
JMGL_MAX_HISTORY_TURNS=20
JMGL_MAX_BATCH_ITEMS=50

# --- CORS (comma-separated browser origins allowed to call the API directly) ---------------
JMGL_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- audit log ---------------------------------------------------------------------------
JMGL_AUDIT_BACKEND=sql                # sql | file | none
JMGL_AUDIT_DATABASE_URL=sqlite:///./data/jmgl_audit.db
# JMGL_AUDIT_DATABASE_URL=postgresql+psycopg://jmgl:PASSWORD@localhost:5432/jmgl
JMGL_AUDIT_FILE_PATH=./data/jmgl_audit.jsonl
JMGL_AUDIT_LOG_RAW=false              # true stores raw input text = personal data (see docs/DATA_PROTECTION.md)
JMGL_AUDIT_HASH_SECRET=               # set a long random value so input hashes can't be dictionary-reversed
JMGL_AUDIT_RETENTION_DAYS=90          # 0 = keep forever
JMGL_AUDIT_PURGE_INTERVAL_MINUTES=60
JMGL_AUDIT_REQUIRED=true              # no verdict (503) if the audit record can't be written

# --- docs --------------------------------------------------------------------------------
JMGL_DOCS_ENABLED=true                # /docs, /redoc, /openapi.json

# --- local docker compose only -------------------------------------------------------------
POSTGRES_PASSWORD=jmgl_local_only
